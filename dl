import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt

from tensorflow.keras.applications import VGG16
from tensorflow.keras.applications.vgg16 import preprocess_input
from tensorflow.keras.utils import load_img, img_to_array

# 1. Load pre-trained VGG16
model = VGG16(weights="imagenet")

# 2. Load a local ImageNet image
image_path = "cat.jpg"  # Change to your image path

img = load_img(image_path, target_size=(224, 224))
image = img_to_array(img)

# Display input image
plt.figure(figsize=(4, 4))
plt.imshow(image.astype("uint8"))
plt.title("Input Image")
plt.axis("off")
plt.show()

# 3. Preprocess image
x = np.expand_dims(image.copy(), axis=0)
x = preprocess_input(x)

# 4. Select layers from different depths
layer_names = [
    "block1_conv1",  # Shallow layer
    "block2_conv2",  # Intermediate layer
    "block5_conv3"   # Deep layer
]

# 5. Create a model to extract feature maps
outputs = [model.get_layer(name).output for name in layer_names]

feature_model = tf.keras.Model(
    inputs=model.input,
    outputs=outputs
)

# 6. Extract feature maps
feature_maps = feature_model.predict(x, verbose=0)

# 7. Visualize feature maps and print dimensions
for layer_name, features in zip(layer_names, feature_maps):

    print("\nLayer:", layer_name)
    print("Feature map dimensions:", features.shape)

    # Display first 8 feature maps
    plt.figure(figsize=(12, 4))
    plt.suptitle("Feature Maps - " + layer_name)

    for i in range(8):
        plt.subplot(2, 4, i + 1)
        plt.imshow(features[0, :, :, i], cmap="gray")
        plt.axis("off")
        plt.title("Map " + str(i + 1))

    plt.tight_layout()
    plt.show()

# 8. Visualize learned filters from the first convolutional layer
layer = model.get_layer("block1_conv1")
filters, biases = layer.get_weights()

print("\nFilter layer:", layer.name)
print("Filter dimensions:", filters.shape)

# Normalize filters for visualization
filters_min = filters.min()
filters_max = filters.max()
filters = (filters - filters_min) / (filters_max - filters_min + 1e-8)

plt.figure(figsize=(10, 5))
plt.suptitle("Learned Filters - block1_conv1")

for i in range(8):
    plt.subplot(2, 4, i + 1)
    plt.imshow(filters[:, :, :, i])
    plt.axis("off")
    plt.title("Filter " + str(i + 1))

plt.tight_layout()
plt.show()
Expected output
The selected layers have the following dimensions for a 224 × 224 input image:
Layer	Feature-map dimensions	Interpretation
block1_conv1	224 × 224 × 64	Basic edges, colors and simple patterns
block2_conv2	112 × 112 × 128	Textures and combinations of edges
block5_conv3	14 × 14 × 512	Complex patterns and object-part features
The batch dimension is included in the printed shape, so the full shapes will be (1, 224, 224, 64), (1, 112, 112, 128), and (1, 14, 14, 512).
Interpretation for your lab record
1. Early layer: Feature maps retain high spatial resolution and respond to basic edges, orientations and color contrasts.
2. Intermediate layer: Feature maps capture more complex textures and combinations of local patterns. Spatial resolution decreases.
3. Deep layer: Feature maps contain more channels but smaller spatial dimensions. They represent increasingly complex patterns associated with object parts and semantic structures.
4. Convolutional filters: The first layer's learned filters often resemble edge detectors, color-sensitive filters and simple oriented patterns.
Note: Feature maps are activation outputs for your chosen image, whereas filters are the learned weights of the convolutional layer. This code visualizes both. The exact activations depend on the input image.


  
import os
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf

from tensorflow.keras.applications import VGG16
from tensorflow.keras.applications.vgg16 import preprocess_input
from tensorflow.keras.utils import load_img, img_to_array
from tensorflow.keras.layers import GlobalAveragePooling2D
from tensorflow.keras.models import Model
from tensorflow.keras import Sequential
from tensorflow.keras.layers import Dense, Dropout

from sklearn.model_selection import train_test_split
from sklearn.metrics import confusion_matrix, classification_report, ConfusionMatrixDisplay

# 1. Load ImageNet images from local folders
path = "dataset"
IMG_SIZE = (224, 224)

images = []
labels = []

for class_name in sorted(os.listdir(path)):
    class_path = os.path.join(path, class_name)

    if os.path.isdir(class_path):
        for file in os.listdir(class_path):
            if file.lower().endswith((".jpg", ".jpeg", ".png")):
                img = load_img(
                    os.path.join(class_path, file),
                    target_size=IMG_SIZE
                )
                images.append(img_to_array(img))
                labels.append(class_name)

if len(images) == 0:
    raise ValueError("No images found. Check the dataset folder.")

images = np.array(images, dtype=np.float32)
labels = np.array(labels)

# Convert class names to numbers
class_names = sorted(np.unique(labels))
class_to_number = {name: i for i, name in enumerate(class_names)}
y = np.array([class_to_number[label] for label in labels])

print("Number of images:", len(images))
print("Classes:", class_names)

# Check that each class has enough images
if min(np.bincount(y)) < 2:
    raise ValueError("Each class needs at least 2 images.")

# 2. Split into training and testing images
X_train, X_test, y_train, y_test = train_test_split(
    images, y,
    test_size=0.2,
    random_state=42,
    stratify=y
)

# 3. Load VGG16 without its original classification layers
base_model = VGG16(
    weights="imagenet",
    include_top=False,
    input_shape=(224, 224, 3)
)

# 4. Extract high-level features using Global Average Pooling
feature_model = Sequential([
    base_model,
    GlobalAveragePooling2D()
])

# Freeze the pre-trained CNN
base_model.trainable = False

# Preprocess images for VGG16
X_train = preprocess_input(X_train.copy())
X_test = preprocess_input(X_test.copy())

# Extract feature vectors
train_features = feature_model.predict(
    X_train, batch_size=16, verbose=1
)

test_features = feature_model.predict(
    X_test, batch_size=16, verbose=1
)

print("\nTraining feature shape:", train_features.shape)
print("Testing feature shape:", test_features.shape)
print("Feature vector dimension:", train_features.shape[1])

# 5. Save extracted feature vectors
np.save("train_features.npy", train_features)
np.save("test_features.npy", test_features)
np.save("train_labels.npy", y_train)
np.save("test_labels.npy", y_test)

# 6. Build a new classification layer
num_classes = len(class_names)

classifier = Sequential([
    tf.keras.Input(shape=(train_features.shape[1],)),
    Dense(128, activation="relu"),
    Dropout(0.3),
    Dense(num_classes, activation="softmax")
])

classifier.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

# 7. Train the classifier on extracted features
history = classifier.fit(
    train_features, y_train,
    epochs=15,
    batch_size=16,
    validation_split=0.2,
    verbose=1
)

# 8. Test on unseen images
predictions = classifier.predict(test_features, verbose=0)
y_pred = np.argmax(predictions, axis=1)

# 9. Calculate evaluation metrics
print("\nClassification Report:")
print(classification_report(
    y_test,
    y_pred,
    labels=np.arange(num_classes),
    target_names=class_names,
    zero_division=0
))

# 10. Display confusion matrix
cm = confusion_matrix(
    y_test, y_pred,
    labels=np.arange(num_classes)
)

display = ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=class_names
)

fig, ax = plt.subplots(figsize=(8, 6))
display.plot(ax=ax, cmap="Blues", xticks_rotation=45)
plt.title("Transfer Learning Confusion Matrix")
plt.tight_layout()
plt.show()

# 11. Plot classifier accuracy
plt.plot(history.history["accuracy"], label="Training Accuracy")
plt.plot(history.history["val_accuracy"], label="Validation Accuracy")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.title("Classifier Accuracy")
plt.legend()
plt.show()

# 12. Predict the class of one test image
i = 0
predicted_class = class_names[y_pred[i]]
actual_class = class_names[y_test[i]]

plt.imshow(
    X_test[i].copy()[..., ::-1] if False else images[
        np.where(y == y_test[i])[0][0]
    ].astype("uint8")
)
plt.title("Actual: " + actual_class + "\nPredicted: " + predicted_class)
plt.axis("off")
plt.show()
