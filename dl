import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt
import os

from tensorflow.keras import layers, Model

# 1. Load local ImageNet images
path = "dataset"
IMG_SIZE = 64
BATCH_SIZE = 32
NOISE_DIM = 100
EPOCHS = 50

dataset = tf.keras.utils.image_dataset_from_directory(
    path,
    image_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE,
    label_mode="int",
    shuffle=True
)

class_names = dataset.class_names
num_classes = len(class_names)

print("Classes:", class_names)

# Normalize images to [-1, 1]
dataset = dataset.map(
    lambda images, labels: (
        tf.cast(images, tf.float32) / 127.5 - 1.0,
        labels
    )
).prefetch(tf.data.AUTOTUNE)

# 2. Create text descriptions from class labels
captions = [
    "a photo of " + name.replace("_", " ").replace("-", " ")
    for name in class_names
]

print("\nText descriptions:")
for caption in captions:
    print(caption)

# 3. Convert text into numerical representations
text_encoder = layers.TextVectorization(
    output_mode="multi_hot"
)

text_encoder.adapt(captions)

vocab_size = len(text_encoder.get_vocabulary())

print("\nVocabulary size:", vocab_size)

caption_tensor = tf.constant(captions)

# 4. Build the Generator
noise_input = layers.Input(shape=(NOISE_DIM,))
text_input = layers.Input(shape=(vocab_size,))

combined = layers.Concatenate()([noise_input, text_input])

x = layers.Dense(8 * 8 * 256, activation="relu")(combined)
x = layers.Reshape((8, 8, 256))(x)

x = layers.BatchNormalization()(x)
x = layers.Conv2DTranspose(
    128, 4, strides=2, padding="same", activation="relu"
)(x)

x = layers.BatchNormalization()(x)
x = layers.Conv2DTranspose(
    64, 4, strides=2, padding="same", activation="relu"
)(x)

x = layers.Conv2DTranspose(
    32, 4, strides=2, padding="same", activation="relu"
)(x)

generated_image = layers.Conv2D(
    3, 3, padding="same", activation="tanh"
)(x)

generator = Model(
    [noise_input, text_input],
    generated_image,
    name="Generator"
)

generator.summary()

# 5. Build the Discriminator
image_input = layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3))
text_input_d = layers.Input(shape=(vocab_size,))

text_map = layers.Reshape((1, 1, vocab_size))(text_input_d)
text_map = layers.UpSampling2D(
    size=(IMG_SIZE, IMG_SIZE)
)(text_map)

combined_image = layers.Concatenate()([image_input, text_map])

x = layers.Conv2D(
    64, 4, strides=2, padding="same"
)(combined_image)
x = layers.LeakyReLU(negative_slope=0.2)(x)

x = layers.Conv2D(
    128, 4, strides=2, padding="same"
)(x)
x = layers.LeakyReLU(negative_slope=0.2)(x)

x = layers.Conv2D(
    256, 4, strides=2, padding="same"
)(x)
x = layers.LeakyReLU(negative_slope=0.2)(x)

x = layers.Flatten()(x)
validity = layers.Dense(1, activation="sigmoid")(x)

discriminator = Model(
    [image_input, text_input_d],
    validity,
    name="Discriminator"
)

discriminator.summary()

# 6. Define losses and optimizers
loss_function = tf.keras.losses.BinaryCrossentropy()

g_optimizer = tf.keras.optimizers.Adam(
    learning_rate=0.0002, beta_1=0.5
)

d_optimizer = tf.keras.optimizers.Adam(
    learning_rate=0.0002, beta_1=0.5
)

# 7. Train Generator and Discriminator
for epoch in range(EPOCHS):

    g_losses = []
    d_losses = []

    for real_images, labels in dataset:

        # Get text description for each real image
        batch_captions = tf.gather(caption_tensor, labels)
        text_vectors = text_encoder(batch_captions)

        batch_size = tf.shape(real_images)[0]

        # Generate random noise
        noise = tf.random.normal((batch_size, NOISE_DIM))

        # Train Discriminator
        with tf.GradientTape() as d_tape:

            fake_images = generator(
                [noise, text_vectors], training=True
            )

            real_output = discriminator(
                [real_images, text_vectors], training=True
            )

            fake_output = discriminator(
                [tf.stop_gradient(fake_images), text_vectors],
                training=True
            )

            real_loss = loss_function(
                tf.ones_like(real_output) * 0.9,
                real_output
            )

            fake_loss = loss_function(
                tf.zeros_like(fake_output),
                fake_output
            )

            d_loss = real_loss + fake_loss

        d_gradients = d_tape.gradient(
            d_loss, discriminator.trainable_variables
        )

        d_optimizer.apply_gradients(
            zip(d_gradients, discriminator.trainable_variables)
        )

        # Train Generator
        noise = tf.random.normal((batch_size, NOISE_DIM))

        with tf.GradientTape() as g_tape:

            fake_images = generator(
                [noise, text_vectors], training=True
            )

            fake_output = discriminator(
                [fake_images, text_vectors], training=False
            )

            g_loss = loss_function(
                tf.ones_like(fake_output),
                fake_output
            )

        g_gradients = g_tape.gradient(
            g_loss, generator.trainable_variables
        )

        g_optimizer.apply_gradients(
            zip(g_gradients, generator.trainable_variables)
        )

        g_losses.append(float(g_loss))
        d_losses.append(float(d_loss))

    print(
        f"Epoch {epoch + 1}/{EPOCHS} | "
        f"Generator Loss: {np.mean(g_losses):.4f} | "
        f"Discriminator Loss: {np.mean(d_losses):.4f}"
    )

# 8. Generate an image from a text description
prompt = "a photo of " + class_names[0].replace("_", " ").replace("-", " ")

text_vector = text_encoder(tf.constant([prompt]))
noise = tf.random.normal((1, NOISE_DIM))

generated = generator(
    [noise, text_vector], training=False
)[0]

generated = (generated.numpy() + 1) / 2
generated = np.clip(generated, 0, 1)

# 9. Display generated image
plt.figure(figsize=(5, 5))
plt.imshow(generated)
plt.title("Text: " + prompt)
plt.axis("off")
plt.show()

print("Generated image for:", prompt)

# 10. Compare with a real image from the same class
real_example = None
class_index = 0

for real_batch, label_batch in dataset:
    matches = tf.where(label_batch == class_index)

    if tf.shape(matches)[0].numpy() > 0:
        real_example = real_batch[int(matches[0, 0].numpy())]
        break

if real_example is not None:

    plt.figure(figsize=(9, 4))

    plt.subplot(1, 2, 1)
    plt.imshow(
        np.clip((real_example.numpy() + 1) / 2, 0, 1)
    )
    plt.title("Real Image: " + class_names[class_index])
    plt.axis("off")

    plt.subplot(1, 2, 2)
    plt.imshow(generated)
    plt.title("Generated Image")
    plt.axis("off")

    plt.tight_layout()
    plt.show()

# 11. Save the trained Generator
generator.save("text_conditioned_generator.keras")
print("Generator saved successfully.")


