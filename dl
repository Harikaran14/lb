import os
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf

from tensorflow.keras.applications import VGG16
from tensorflow.keras.applications.vgg16 import preprocess_input
from tensorflow.keras.utils import load_img, img_to_array
from tensorflow.keras.layers import Input, Embedding, LSTM, Dense, Dropout
from tensorflow.keras.models import Model
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences

# 1. Load local ImageNet images
path = "dataset"
IMG_SIZE = (224, 224)
MAX_IMAGES_PER_CLASS = 50

images = []
captions = []

for class_name in sorted(os.listdir(path)):
    class_path = os.path.join(path, class_name)

    if os.path.isdir(class_path):
        count = 0

        for file in sorted(os.listdir(class_path)):
            if file.lower().endswith((".jpg", ".jpeg", ".png")):

                img = load_img(
                    os.path.join(class_path, file),
                    target_size=IMG_SIZE
                )

                images.append(img_to_array(img))

                # Convert folder name into a caption
                label = class_name.replace("_", " ").replace("-", " ")
                caption = "startseq a photo of " + label.lower() + " endseq"
                captions.append(caption)

                count += 1
                if count >= MAX_IMAGES_PER_CLASS:
                    break

if len(images) == 0:
    raise ValueError("No images found. Check the dataset folder.")

images = np.array(images, dtype=np.float32)
print("Number of images:", len(images))

# 2. Load pre-trained VGG16 as CNN encoder
cnn = VGG16(
    weights="imagenet",
    include_top=False,
    pooling="avg",
    input_shape=(224, 224, 3)
)

cnn.trainable = False

# 3. Extract image feature vectors
x = preprocess_input(images.copy())
features = cnn.predict(x, batch_size=16, verbose=1)

print("Image feature shape:", features.shape)

# 4. Tokenize captions and build vocabulary
tokenizer = Tokenizer(
    filters="",
    lower=True,
    oov_token="<unk>"
)

tokenizer.fit_on_texts(captions)

sequences = tokenizer.texts_to_sequences(captions)
vocab_size = len(tokenizer.word_index) + 1
max_length = max(len(seq) for seq in sequences)

print("Vocabulary size:", vocab_size)
print("Maximum caption length:", max_length)

# 5. Prepare next-word training sequences
image_inputs = []
text_inputs = []
next_words = []

for i, seq in enumerate(sequences):
    for j in range(1, len(seq)):
        image_inputs.append(features[i])
        text_inputs.append(seq[:j])
        next_words.append(seq[j])

text_inputs = pad_sequences(
    text_inputs,
    maxlen=max_length - 1,
    padding="post"
)

image_inputs = np.array(image_inputs, dtype=np.float32)
text_inputs = np.array(text_inputs, dtype=np.int32)
next_words = np.array(next_words, dtype=np.int32)

print("Training samples:", len(next_words))

# 6. Build CNN-LSTM caption decoder
image_input = Input(shape=(features.shape[1],), name="image_features")
text_input = Input(shape=(max_length - 1,), name="text_sequence")

image_embedding = Dense(128, activation="relu")(image_input)
image_embedding = Dropout(0.2)(image_embedding)
image_embedding = tf.keras.layers.RepeatVector(1)(image_embedding)

word_embedding = Embedding(
    input_dim=vocab_size,
    output_dim=128,
    mask_zero=True
)(text_input)

# Combine image representation and word sequence
combined = tf.keras.layers.Concatenate(axis=1)(
    [image_embedding, word_embedding]
)

lstm_output = LSTM(256)(combined)
output = Dense(vocab_size, activation="softmax")(lstm_output)

model = Model(
    inputs=[image_input, text_input],
    outputs=output
)

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

model.summary()

# 7. Train the caption generation model
model.fit(
    [image_inputs, text_inputs],
    next_words,
    epochs=20,
    batch_size=32,
    validation_split=0.1
)

# 8. Generate a caption for an image
def generate_caption(feature):
    caption = "startseq"

    for _ in range(max_length):
        sequence = tokenizer.texts_to_sequences([caption])[0]

        sequence = pad_sequences(
            [sequence],
            maxlen=max_length - 1,
            padding="post",
            truncating="post"
        )

        prediction = model.predict(
            [feature.reshape(1, -1), sequence],
            verbose=0
        )

        word_index = np.argmax(prediction[0])
        word = tokenizer.index_word.get(word_index, "")

        if word == "endseq" or word == "":
            break

        caption += " " + word

    return caption.replace("startseq", "").strip()

# 9. Test on a previously unseen image
# Use a separate test image from your dataset.
test_image_path = "test.jpg"  # Replace with your image path

test_img = load_img(test_image_path, target_size=IMG_SIZE)
test_array = img_to_array(test_img)

test_x = preprocess_input(np.expand_dims(test_array.copy(), axis=0))
test_feature = cnn.predict(test_x, verbose=0)[0]

generated_caption = generate_caption(test_feature)

# 10. Display image and generated caption
plt.figure(figsize=(6, 5))
plt.imshow(test_img)
plt.title("Generated Caption:\n" + generated_caption)
plt.axis("off")
plt.show()

print("Generated caption:", generated_caption)
