# EXPERIMENT 1 : ImageNet Preprocessing and Visualization
# ==========================================================

from tensorflow.keras.preprocessing import image
from tensorflow.keras.applications import VGG16
from tensorflow.keras.applications.vgg16 import preprocess_input, decode_predictions
import numpy as np
import matplotlib.pyplot as plt
import os

path = "imagenet/images"
images = []
labels = []

# load a subset: 10 classes
for c in sorted(os.listdir(path))[:10]:
    folder = os.path.join(path, c)

    if os.path.isdir(folder):
        for f in os.listdir(folder):
            if f.lower().endswith((".jpg", ".jpeg", ".png")):
                images.append(os.path.join(folder, f))
                labels.append(c)

# split into train (80%) and test (20%)
idx = np.random.permutation(len(images))
cut = int(0.8 * len(images))
train_idx, test_idx = idx[:cut], idx[cut:]
print("Train:", len(train_idx), "Test:", len(test_idx))

# display random images with their class labels
plt.figure(figsize=(15, 3))
for k, j in enumerate(np.random.choice(len(images), 5, replace=False)):
    plt.subplot(1, 5, k + 1)
    plt.imshow(image.load_img(images[j]))
    plt.title(labels[j])
    plt.axis("off")
plt.show()

# pick one random test image
i = np.random.choice(test_idx)
img_path = images[i]

img = image.load_img(img_path)
arr = image.img_to_array(img)

print("Original label:", labels[i])
print("Original shape:", arr.shape)
print("Original pixel values:")
print(arr[:5, :5, :])

# resize to 224x224
img = image.load_img(img_path, target_size=(224, 224))
x = image.img_to_array(img)
print("Resized shape:", x.shape)

# add batch dimension
x = np.expand_dims(x, axis=0)

# normalize as required by VGG16
x = preprocess_input(x)

print("Preprocessed shape:", x.shape)
print("Preprocessed pixel values:")
print(x[0, :5, :5, :])

# load pre-trained model and predict
model = VGG16(weights="imagenet")

pred = model.predict(x)
print("Output shape:", pred.shape)
results = decode_predictions(pred, top=5)

print("Top 5 predictions:")
for r in results[0]:
    print(r[1], round(r[2] * 100, 2), "%")

# compare original and predicted label
print("Original label:", labels[i])
print("Predicted label:", results[0][0][1])


